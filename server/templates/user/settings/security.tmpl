{{template "base/head" .}}
<div class="user settings security">
	<div class="ui container">
		<div class="ui grid">
			{{template "user/settings/navbar" .}}
			<div class="twelve wide column content">
				{{template "base/alert" .}}
				<h4 class="ui top attached header">Account security</h4>
				<div class="ui attached segment">
					<p>Accounts and passwords are managed by <strong>user-management</strong> (the dsh login).</p>
					<ul class="ui list">
						<li>Change password / enable two-step verification: dsh 设置 → 用户管理</li>
						<li>This Git server authenticates against the same account — no separate credentials.</li>
					</ul>
				</div>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
